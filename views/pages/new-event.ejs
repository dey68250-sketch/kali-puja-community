<% layout("/layouts/boilerplate") %>

<section class="new-event-page">

    <div class="container">

        <div class="new-event-header">

            <p class="events-label">
                🪔 COMMUNITY MANAGEMENT
            </p>

            <h1>
                Create New Event
            </h1>

            <p>
                Add a new event to the community calendar.
            </p>

        </div>


        <div class="event-form-wrapper">

            <form
                action="/events"
                method="POST"
                class="event-form"
            >

                <!-- Title -->

                <div class="form-group">

                    <label for="title">
                        Event Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="Cultural Night"
                        required
                    >

                </div>


                <!-- Description -->

                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="5"
                        placeholder="Describe the event..."
                        required
                    ></textarea>

                </div>


                <!-- Date + Time -->

                <div class="form-row">

                    <div class="form-group">

                        <label for="date">
                            Date
                        </label>

                        <input
                            type="date"
                            id="date"
                            name="date"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="time">
                            Time
                        </label>

                        <input
                            type="time"
                            id="time"
                            name="time"
                            required
                        >

                    </div>

                </div>


                <!-- Location -->

                <div class="form-group">

                    <label for="location">
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        placeholder="Kali Puja Community Ground"
                        required
                    >

                </div>


                <!-- Category -->

                <div class="form-group">

                    <label for="category">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                    >

                        <option value="Puja">
                            Puja
                        </option>

                        <option value="Cultural">
                            Cultural
                        </option>

                        <option value="Competition">
                            Competition
                        </option>

                        <option value="Social">
                            Social
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- Submit -->

                <button
                    type="submit"
                    class="create-event-btn"
                >
                    Create Event ✨
                </button>

            </form>

        </div>

    </div>

</section>