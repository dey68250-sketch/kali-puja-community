<% layout("/layouts/boilerplate") %>

<section class="donate-page">

    <!-- Background decorations -->
    <div class="donate-orb donate-orb-1"></div>
    <div class="donate-orb donate-orb-2"></div>

    <div class="container">

        <!-- Header -->
        <div class="donate-header">

            <p class="donate-label">
                🪔 SUPPORT OUR COMMUNITY
            </p>

            <h1>
                Support <span>Maa Kali Puja</span>
            </h1>

            <p>
                Your contribution helps us continue our traditions,
                organize Kali Puja, cultural programs, bhog distribution
                and community activities.
            </p>

        </div>


        <!-- Main Donation Area -->
        <div class="donation-wrapper">

            <!-- LEFT -->
            <div class="donation-content">

                <div class="donation-icon">
                    🪔
                </div>

                <h2>
                    Make a Contribution
                </h2>

                <p class="donation-description">
                    Every contribution, big or small, helps us bring
                    the community together and preserve our traditions.
                </p>


                <!-- Donation information -->
                <div class="donation-info">

                    <div class="donation-info-item">

                        <div class="info-icon">
                            💳
                        </div>

                        <div>
                            <span>UPI ID</span>
                            <strong>yourupi@upi</strong>
                        </div>

                    </div>


                    <div class="donation-info-item">

                        <div class="info-icon">
                            👤
                        </div>

                        <div>
                            <span>Account Name</span>
                            <strong>Maa Kali Puja Community</strong>
                        </div>

                    </div>

                </div>


                <div class="donation-note">
                    <span>📱</span>

                    <p>
                        Open Google Pay, PhonePe, Paytm or any
                        UPI application and scan the QR code.
                    </p>
                </div>

            </div>


            <!-- RIGHT : QR -->
            <div class="qr-section">

                <div class="qr-title">
                    <span>SCAN TO DONATE</span>
                </div>

                <div class="qr-scene">

                    <div class="qr-glow"></div>

                    <div class="qr-card-3d" id="qrCard">

                        <div class="qr-top">
                            <span>🪔</span>
                            <span>UPI PAYMENT</span>
                        </div>

                        <div class="qr-frame">

                            <img
                                src="/images/WhatsApp Image 2026-10-07 at 20.22.03.jpeg"
                                alt="Donation QR Code"
                            >

                            <div class="scan-line"></div>

                        </div>

                        <div class="qr-bottom">
                            <span>SECURE</span>
                            <span>•</span>
                            <span>FAST</span>
                            <span>•</span>
                            <span>EASY</span>
                        </div>

                    </div>

                </div>

                <p class="scan-text">
                    Scan with your UPI app
                </p>

            </div>

        </div>


        <!-- Bottom message -->
        <div class="donation-thanks">

            <span>🙏</span>

            <p>
                Thank you for supporting our community and
                keeping the spirit of Maa Kali alive.
            </p>

            <span>🙏</span>

        </div>

    </div>

</section>