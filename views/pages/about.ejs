<% layout("/layouts/boilerplate") %>

<section class="about-page">

    <div class="container">

        <div class="about-header">

            <p class="about-label">
                🪔 OUR STORY
            </p>

            <h1>
                About Our Community
            </h1>

            <p class="about-intro">
                More than a Puja, we are a community
                connected by devotion, culture and tradition.
            </p>

        </div>


        <div class="row align-items-center mt-5">

            <div class="col-lg-6">

                <div class="about-image">
                    <div class="about-image-placeholder">
                        🕉️
                    </div>
                </div>

            </div>


            <div class="col-lg-6">

                <div class="about-content">

                    <h2>
                        Our Journey
                    </h2>

                    <p>
                        Our Kali Puja community brings people
                        together every year to celebrate Maa Kali
                        with devotion, joy and togetherness.
                    </p>

                    <p>
                        Along with the traditional Puja, our
                        community organizes cultural programs,
                        social activities and events that bring
                        families and friends together.
                    </p>

                    <p>
                        Our goal is to preserve our traditions
                        while creating a welcoming community
                        for everyone.
                    </p>

                </div>

            </div>

        </div>


        <div class="about-values mt-5">

            <div class="value-card">

                <span>🙏</span>

                <h3>Devotion</h3>

                <p>
                    Celebrating Maa Kali with faith and devotion.
                </p>

            </div>


            <div class="value-card">

                <span>🤝</span>

                <h3>Unity</h3>

                <p>
                    Bringing our community together as one.
                </p>

            </div>


            <div class="value-card">

                <span>🪔</span>

                <h3>Tradition</h3>

                <p>
                    Keeping our culture and traditions alive.
                </p>

            </div>

        </div>

    </div>

</section>