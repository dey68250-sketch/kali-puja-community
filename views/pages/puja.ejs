<% layout("/layouts/boilerplate") %>

<section class="puja-page">

    <div class="container">

        <div class="puja-header puja-reveal">

            <p class="puja-label">🪔 THE SACRED CELEBRATION</p>

            <h1>Kali Puja</h1>

            <p>
                Join us in celebrating Maa Kali with devotion,
                tradition, culture and community.
            </p>

        </div>


        <!-- Schedule -->

        <div class="puja-section">

            <h2 class="section-title">
                Puja Schedule
            </h2>

            <div class="puja-timeline">

                <div class="puja-event">
                    <span class="puja-time">06:00 PM</span>

                    <div>
                        <h3>Sandhya Aarti</h3>
                        <p>
                            Evening prayers and devotional songs.
                        </p>
                    </div>
                </div>


                <div class="puja-event">
                    <span class="puja-time">08:00 PM</span>

                    <div>
                        <h3>Maa Kali Puja</h3>
                        <p>
                            Traditional Puja and rituals.
                        </p>
                    </div>
                </div>


                <div class="puja-event">
                    <span class="puja-time">10:00 PM</span>

                    <div>
                        <h3>Bhog Distribution</h3>
                        <p>
                            Prasad and Bhog will be distributed
                            among devotees.
                        </p>
                    </div>
                </div>


                <div class="puja-event">
                    <span class="puja-time">11:00 PM</span>

                    <div>
                        <h3>Cultural Program</h3>
                        <p>
                            Music, dance and cultural performances.
                        </p>
                    </div>
                </div>

            </div>

        </div>


        <!-- Special Attractions -->

        <div class="puja-section">

            <h2 class="section-title">
                Special Attractions
            </h2>


            <div class="attractions">

                <div class="attraction-card">

                    <span>🙏</span>

                    <h3>Traditional Puja</h3>

                    <p>
                        Experience the traditional rituals
                        and devotional atmosphere.
                    </p>

                </div>


                <div class="attraction-card">

                    <span>🎶</span>

                    <h3>Cultural Program</h3>

                    <p>
                        Enjoy performances by members
                        of our community.
                    </p>

                </div>


                <div class="attraction-card">

                    <span>🍚</span>

                    <h3>Bhog Prasad</h3>

                    <p>
                        Receive Maa Kali's blessed Bhog
                        with fellow devotees.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>